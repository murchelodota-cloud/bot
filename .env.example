# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Твой Telegram user_id (узнать: @userinfobot). Через запятую можно несколько.
OWNER_IDS=123456789

# Канал/чат для отчётов /report (бот должен быть там админом). Можно оставить пустым.
REPORT_CHAT_ID=

# Путь к базе
DB_PATH=lika.db

# Необязательно: языковая модель для связных сводок (!сводка24). Любой OpenAI-совместимый API.
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
